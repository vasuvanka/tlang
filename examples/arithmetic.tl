// Arithmetic operations example
// Demonstrates all math operators with explicit types

dhimpu "fmt" as fmt;

#prarambham() {
    @a int = 10;
    @b int = 3;

    fmt.Printf("a = %d\n", a);
    fmt.Printf("b = %d\n", b);

    fmt.Printf("\nAddition (a + b): %d\n", a + b);
    fmt.Printf("Subtraction (a - b): %d\n", a - b);
    fmt.Printf("Multiplication (a * b): %d\n", a * b);
    fmt.Printf("Division (a / b): %d\n", a / b);
    fmt.Printf("Modulo (a %% b): %d\n", a % b);
    fmt.Printf("Power (a ^ b): %d\n", a ^ b);
}

//

//

//

//

//

// === OUTPUT ===
// a = 10
// b = 3
//
// Addition (a + b): 13
// Subtraction (a - b): 7
// Multiplication (a * b): 30
// Division (a / b): 3
// Modulo (a % b): 1
// Power (a ^ b): 0
//
