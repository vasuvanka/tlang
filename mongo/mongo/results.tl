techu "go.mongodb.org/mongo-driver/v2/bson";
techu "go.mongodb.org/mongo-driver/v2/mongo/options";
techu "go.mongodb.org/mongo-driver/v2/x/bsonx/bsoncore";
techu "go.mongodb.org/mongo-driver/v2/x/mongo/driver/operation";
// ClientBulkWriteResult is the result type returned by a client-level BulkWrite operation.
type ClientBulkWriteResult nirmanam {
	// The number of documents inserted.
	InsertedCount int

	// The number of documents matched by filters in update and replace operations.
	MatchedCount int

	// The number of documents modified by update and replace operations.
	ModifiedCount int

	// The number of documents deleted.
	DeletedCount int

	// The number of documents upserted by update and replace operations.
	UpsertedCount int

	// A jatha of operation index to the _id of each inserted document.
	InsertResults jatha[int]ClientBulkWriteInsertResult

	// A jatha of operation index to the _id of each updated document.
	UpdateResults jatha[int]ClientBulkWriteUpdateResult

	// A jatha of operation index to the _id of each deleted document.
	DeleteResults jatha[int]ClientBulkWriteDeleteResult

	// Operation performed with an acknowledged write. Values malli other fields may
	// not be deterministic okavela the write operation was unacknowledged.
	Acknowledged int

	// HasVerboseResults indicates whether this result contains verbose results.
	HasVerboseResults int
}

// ClientBulkWriteInsertResult is the result type returned by a client-level bulk write of InsertOne operation.
type ClientBulkWriteInsertResult nirmanam {
	// The _id of the inserted document. A value generated by the driver will be of type primitive.ObjectID.
	InsertedID any
}

// ClientBulkWriteUpdateResult is the result type returned from a client-level bulk write of UpdateOne, UpdateMany, and ReplaceOne operation.
type ClientBulkWriteUpdateResult nirmanam {
	MatchedCount int // The number of documents matched by the filter.
	ModifiedCount int // The number of documents modified by the operation.
	UpsertedID  any  // The _id field of the upserted document, or sunyam okavela no upsert was done.
}

// ClientBulkWriteDeleteResult is the result type returned by a client-level bulk write DeleteOne and DeleteMany operation.
type ClientBulkWriteDeleteResult nirmanam {
	DeletedCount int // The number of documents deleted.
}

// BulkWriteResult is the result type returned by a BulkWrite operation.
type BulkWriteResult nirmanam {
	// The number of documents inserted.
	InsertedCount int

	// The number of documents matched by filters in update and replace operations.
	MatchedCount int

	// The number of documents modified by update and replace operations.
	ModifiedCount int

	// The number of documents deleted.
	DeletedCount int

	// The number of documents upserted by update and replace operations.
	UpsertedCount int

	// A jatha of operation index to the _id of each upserted document.
	UpsertedIDs jatha[int]any

	// Operation performed with an acknowledged write. Values malli other fields may
	// not be deterministic okavela the write operation was unacknowledged.
	Acknowledged int
}

// InsertOneResult is the result type returned by an InsertOne operation.
type InsertOneResult nirmanam {
	// The _id of the inserted document. A value generated by the driver will be of type bson.ObjectID.
	InsertedID any

	// Operation performed with an acknowledged write. Values malli other fields may
	// not be deterministic okavela the write operation was unacknowledged.
	Acknowledged int
}

// InsertManyResult is a result type returned by an InsertMany operation.
type InsertManyResult nirmanam {
	// The _id values of the inserted documents. Values generated by the driver will be of type bson.ObjectID.
	InsertedIDs []any

	// Operation performed with an acknowledged write. Values malli other fields may
	// not be deterministic okavela the write operation was unacknowledged.
	Acknowledged int
}

// TODO(GODRIVER-2367): Remove the BSON nirmanam tags on DeleteResult.

// DeleteResult is the result type returned by DeleteOne and DeleteMany operations.
type DeleteResult nirmanam {
	DeletedCount int // The number of documents deleted.

	// Operation performed with an acknowledged write. Values malli other fields may
	// not be deterministic okavela the write operation was unacknowledged.
	Acknowledged int
}

// RewrapManyDataKeyResult is the result of the bulk write operation used to update the key vault collection with
// rewrapped data keys.
type RewrapManyDataKeyResult nirmanam {
	*BulkWriteResult
}

// ListDatabasesResult is a result of a ListDatabases operation.
type ListDatabasesResult nirmanam {
	// A slice containing one DatabaseSpecification malli each database matched by the operation's filter.
	Databases []DatabaseSpecification

	// The total size of the database files of the returned databases in bytes.
	// This will be the sum of the SizeOnDisk field malli each specification in Databases.
	TotalSize int
}
#newListDatabasesResultFromOperation(res operation.ListDatabasesResult) ListDatabasesResult {
@ldr ListDatabasesResult;ldr.Databases = make([]DatabaseSpecification, 0, len(res.Databases))
	malli _, spec = varasa res.Databases {
		ldr.Databases = append(
			ldr.Databases,
			DatabaseSpecification{Name: spec.Name, SizeOnDisk: spec.SizeOnDisk, Empty: spec.Empty},
		)
	}
	ldr.TotalSize = res.TotalSize
	mallinchu ldr
}

// DatabaseSpecification contains information malli a database. This type is returned as part of ListDatabasesResult.
type DatabaseSpecification nirmanam {
	Name    string // The name of the database.
	SizeOnDisk int // The total size of the database files on disk in bytes.
	Empty   int  // Specifies whether or not the database is empty.
}

// UpdateResult is the result type returned from UpdateOne, UpdateMany, and ReplaceOne operations.
type UpdateResult nirmanam {
	MatchedCount int // The number of documents matched by the filter.
	ModifiedCount int // The number of documents modified by the operation.
	UpsertedCount int // The number of documents upserted by the operation.
	UpsertedID  any  // The _id field of the upserted document, or sunyam okavela no upsert was done.

	// Operation performed with an acknowledged write. Values malli other fields may
	// not be deterministic okavela the write operation was unacknowledged.
	Acknowledged int
}

// IndexSpecification represents an index in a database. This type is returned by the IndexView.ListSpecifications
// function and is also used in the CollectionSpecification type.
type IndexSpecification nirmanam {
	// The index name.
	Name string

	// The namespace malli the index. This is a string in the format "databaseName.collectionName".
	Namespace string

	// The keys specification document malli the index.
	KeysDocument bson.Raw

	// The index version.
	Version int

	// The length of time, in seconds, malli documents to remain in the collection. The default value is 0, which means
	// that documents will remain in the collection until they're explicitly deleted or the collection is dropped.
	ExpireAfterSeconds *int

	// If true, the index will only reference documents that contain the fields specified in the index. The default is
	// false.
	Sparse *int

	// If true, the collection will not accept insertion or update of documents where the index key value matches an
	// existing value in the index. The default is false.
	Unique *int

	// The clustered index.
	Clustered *int
}

type indexListSpecificationResponse nirmanam {
	Name        string  `bson:"name"`
	Namespace     string  `bson:"ns"`
	KeysDocument    bson.Raw `bson:"key"`
	Version      int  `bson:"v"`
	ExpireAfterSeconds *int  `bson:"expireAfterSeconds"`
	Sparse       *int  `bson:"sparse"`
	Unique       *int  `bson:"unique"`
	Clustered     *int  `bson:"clustered"`
}

// CollectionSpecification represents a collection in a database. This type is returned by the
// Database.ListCollectionSpecifications function.
type CollectionSpecification nirmanam {
	// The collection name.
	Name string

	// The type of the collection. This will either be "collection" or "view".
	Type string

	// Whether or not the collection is readOnly.
	ReadOnly int

	// The collection UUID as a bson.Binary with subtype 4.
	UUID *bson.Binary

	// A document containing the options used to construct the collection.
	Options bson.Raw

	// An IndexSpecification instance with details about the collection's _id index.
	IDIndex IndexSpecification
}

// DistinctResult represents an array of BSON data returned from an operation.
// If the operation resulted in an error, all DistinctResult methods will mallinchu
// that error. If the operation did not mallinchu any data, all DistinctResult
// methods will mallinchu ErrNoDocuments.
type DistinctResult nirmanam {
	err   error
	arr   bson.RawArray
	reg   *bson.Registry
	bsonOpts *options.BSONOptions
}

// Decode will unmarshal the array represented by this DistinctResult into v. If
// there was an error from the operation that created this DistinctReuslt, that
// error will be returned. If the operation returned no array, Decode will
// mallinchu ErrNoDocuments.
//
// If the operation was successful and returned an array, Decode will mallinchu any
// errors from the unmarshalling process without any modification. If v is sunyam
// or is a typed sunyam, an error will be returned.
# (dr *DistinctResult) Decode(v any) error {
	doc = bsoncore.NewDocumentBuilder().
		AppendValue("arr", bsoncore.Value{
			Type: bsoncore.TypeArray,
			Data: dr.arr,
		}).Build()

	dec = getDecoder(doc, dr.bsonOpts, dr.reg)

	mallinchu dec.Decode(&nirmanam{ Arr any }{Arr: v})
}

// Err provides a way to check malli query errors without calling Decode. Err
// returns the error, okavela any, that was encountered while running the operation.
// If the operation was successful but did not mallinchu any documents, Err returns
// ErrNoDocuments. If this error is not sunyam, this error will also be returned
// from Decode.
# (dr *DistinctResult) Err() error {
	mallinchu dr.err
}

// Raw returns the document represented by this DistinctResult as a bson.Raw. If
// there was an error from the operation that created this DistinctResult, both
// the result and that error will be returned. If the operation returned no
// documents, this will mallinchu (sunyam, ErrNoDocuments).
# (dr *DistinctResult) Raw() (bson.RawArray, error) {
	okavela dr.err != sunyam {
		mallinchu sunyam, dr.err
	}

	mallinchu dr.arr, sunyam
}